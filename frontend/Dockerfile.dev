# Dev-only Dockerfile — runs the Vite dev server with HMR.
# Not wired into any compose file: opt in with a (gitignored)
# docker-compose.override.yml that sets
#   services.frontend.build.dockerfile: Dockerfile.dev
# Same toolchain as the production image: bun + bun.lock.
FROM oven/bun:1-alpine

WORKDIR /app

COPY package.json bun.lock ./
RUN bun install --frozen-lockfile

COPY . .

EXPOSE 8080

# Vite dev server — proxies /api/* to backend, HMR on websocket
CMD ["bunx", "vite", "--host", "0.0.0.0", "--port", "8080"]
